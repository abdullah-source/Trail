# Trail server configuration (DECISIONS §5). Copy to .env for local dev; set as Railway
# variables in production. Nothing here is ever logged.

# Postgres on Railway (reference the Postgres service: ${{Postgres.DATABASE_URL}}).
# Unset locally = SQLite file in TRAIL_DATA_DIR (default ./trail-data/trail.sqlite).
DATABASE_URL=

# Ed25519 private key, PEM *contents* (not a path). Generate once:
#   ../.venv/bin/trail keygen --out signer.pem && cat signer.pem
# Railway accepts multi-line values; "\n" escapes are also understood.
TRAIL_SIGNING_KEY=

# Random 32+ byte secret for hashing session and extension tokens. Rotating it signs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Public origin of the app, no trailing slash. Used in magic links, cookies (Secure when https),
# Stripe return URLs and the CSRF origin check.
APP_URL=https://trail.app

# Resend (magic links, renewal reminders). Without RESEND_API_KEY, emails are printed to the log
# (local dev only). RESEND_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=Trail <hello@trail.app>
# "1" lets a production deploy run without RESEND_API_KEY: sign-in links go to the server log
# (early access only; read them with `railway logs`).
MAIL_TO_LOG=

# Free access: "1" gives every account every feature with no trial clock and no paywall; the
# site says "free during early access". Defaults to "1" while STRIPE_SECRET_KEY is unset and to
# "0" once it is set, so leaving Stripe blank is the whole switch. Set explicitly to override.
FREE_ACCESS=

# Clerk (optional hosted sign-in: Google, email codes). With both keys set the web app shows
# Clerk's sign-in box; magic links stay as a fallback. Clerk holds emails and login methods only.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (optional until you want to charge). Prices: Semester $12 every 4 months, Monthly $3.99
# every month. Without these, billing endpoints answer 503 and the app says so.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEMESTER=
STRIPE_PRICE_MONTHLY=

# Optional error reporting (pip install ".[sentry]"). Off when empty. Request bodies are never sent.
SENTRY_DSN=

# "1" (default) lets new emails create accounts; "0" only signs in existing users.
SIGNUP_OPEN=1

# Production guard: when APP_URL is https (or TRAIL_ENV=production) the server refuses to start
# unless SESSION_SECRET (32+ chars, not the dev default), TRAIL_SIGNING_KEY and RESEND_API_KEY
# are all set, and logs which one is missing.
TRAIL_ENV=

# --- frontend build-time (web/.env.production or Docker build args) --------------------------
# Chrome Web Store id of the published extension; the app talks to it over externally_connectable.
VITE_EXTENSION_ID=
# Listing URL shown on install buttons.
VITE_CHROME_STORE_URL=
