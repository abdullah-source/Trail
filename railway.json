{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c 'alembic upgrade head && uvicorn trail.server.app:create_app --factory --host 0.0.0.0 --port $PORT --no-access-log --proxy-headers --forwarded-allow-ips=\"*\"'",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
